# Copy to .env. Never commit the actual secret.
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
APP_ENV=development
FLASK_APP=app:create_app
# Paths default to instance/ inside this project.
# DATABASE_PATH=/absolute/path/to/app.sqlite3
# UPLOAD_DIR=/absolute/path/to/uploads
# SESSION_DIR=/absolute/path/to/sessions
